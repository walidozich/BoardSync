# Copy this file to .env and fill in real values.
# .env holds working values and is gitignored; this file holds placeholders only.

# --- Postgres ---
POSTGRES_USER=boardsync
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=boardsync
POSTGRES_PORT=5432

# --- API ---
API_PORT=5080
ASPNETCORE_ENVIRONMENT=Development
# Host must be the docker-compose service name ("db"), not localhost.
ConnectionStrings__Default=Host=db;Port=5432;Database=boardsync;Username=boardsync;Password=REPLACE_ME
# Browser-facing origin allowed to call the API. Dev only; nginx removes the need for this in prod (single origin).
CorsOrigin=http://localhost:5173
# Self-generatable: openssl rand -base64 64 | tr -d '\n'
Jwt__Secret=REPLACE_ME
Jwt__Issuer=BoardSync
Jwt__Audience=BoardSync.Client
Jwt__LifetimeHours=8
# Requests per window, per client IP, on /api/auth/*. Integration tests override this higher
# so functional test cases sharing one app instance don't trip each other's budget.
RateLimiting__Auth__PermitLimit=10
RateLimiting__Auth__WindowMinutes=1

# --- Client ---
CLIENT_PORT=5173
# Browser-facing URL for the API. Must be reachable from the host machine, not the docker network.
VITE_API_URL=http://localhost:5080
